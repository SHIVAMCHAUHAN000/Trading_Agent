# ==============================================================================
# PERSONAL LIVE QUANT BRAIN — CONFIGURATION
# Copy to .env and fill in. NEVER commit .env with real secrets.
# ==============================================================================

# --- Application Environment ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secure_string_in_production

# --- Database Storage ---
# Default local SQLite database (created automatically)
DATABASE_URL=sqlite+aiosqlite:///data/quant_brain.db
SQLITE_PATH=data/quant_brain.db

# Optional Supabase / Postgres (can be used instead of SQLite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI & Reasoning Engine ---
# Options: 'auto', 'gemini', 'openai', or 'rule_based_quant'
# If no API key is configured, the built-in deterministic quant reasoning engine is used.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram Bot Configuration ---
# 1. Create a bot via @BotFather on Telegram to get your token
# 2. Add your numeric Telegram User ID or username to AUTHORIZED_TELEGRAM_USERS
#    (Get your ID by messaging @userinfobot on Telegram)
#    Leave empty in development to allow all users.
TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_USERS=

# --- TradingView Webhook Integration ---
# Configure this secret token in your TradingView alert webhook payload or header:
# Header: X-TradingView-Secret: tv_secret_webhook_pass_123
# Or in JSON payload: {"secret": "tv_secret_webhook_pass_123", ...}
TRADINGVIEW_WEBHOOK_SECRET=tv_secret_webhook_pass_123

# --- Market Data & Freshness Parameters ---
DATA_CACHE_TTL_PRICE=15
DATA_CACHE_TTL_CANDLES=60
DATA_CACHE_TTL_DAILY=300
MAX_STALE_MINUTES=20

# --- Default Watchlist ---
DEFAULT_WATCHLIST=NIFTY,BANKNIFTY,GOLD,SILVER,CRUDEOIL,BTC,RELIANCE,HDFCBANK

# --- Legacy Backtesting Overrides ---
RESEARCH_CAPITAL_INR=1000000
YF_CACHE_DIR=data/raw/yfinance
OPENROUTER_API_KEY=
HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_BRIDGE_MODEL=gpt-4o-mini
